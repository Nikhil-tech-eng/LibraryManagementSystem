# ─── Database ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=lms_password

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── SMTP / Mailhog ────────────────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=noreply@library.org
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# ─── Inter-service URLs (Docker Compose) ───────────────────────────────────
USER_SERVICE_URL=http://user-service:5002
BOOK_CATALOG_URL=http://book-catalog:5001
BORROWING_SERVICE_URL=http://borrowing-service:5003
NOTIFICATION_SERVICE_URL=http://notification-service:5004

# ─── Service Ports ─────────────────────────────────────────────────────────
BOOK_CATALOG_PORT=5001
USER_SERVICE_PORT=5002
BORROWING_SERVICE_PORT=5003
NOTIFICATION_SERVICE_PORT=5004
FRONTEND_PORT=3000
